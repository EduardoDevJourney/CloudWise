# Required to run locally
# Without DATABASE_URL the backend silently falls back to a local SQLite file.
# The password must match MSSQL_SA_PASSWORD (percent-encode special characters, "@" is %40).
MSSQL_SA_PASSWORD=CloudWise@Dev123
DATABASE_URL=mssql+pymssql://sa:CloudWise%40Dev123@localhost:1433/cloudwise

# Required only to provision on Azure for real (the rest of the portal works without them)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: comma-separated emails that join as admin on their first access.
# The demo seed already creates dev-user@dev.local as admin.
ADMIN_EMAILS=

# Optional in development (these are the defaults).
# Outside development, SECRET_KEY and PULUMI_CONFIG_PASSPHRASE are required.
# APP_ENV=development
# SECRET_KEY=
# PULUMI_STACK=dev
# PULUMI_STATE_DIR=infra/pulumi/.pulumi
# PULUMI_CONFIG_PASSPHRASE=cloudwise-dev
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
