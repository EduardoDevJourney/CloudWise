# Vite only reads the .env inside frontend/ (copy this file to frontend/.env if you need it).
# Locally the dev server proxies /api to http://localhost:8000, so both are optional.

# Base URL of the API when it is not served through the proxy
# VITE_API_URL=http://localhost:8000

# Answer API calls with the MSW mocks instead of the backend
# VITE_ENABLE_MSW=false
